# PostgreSQL / Supabase Connection URL
# Leave empty during local development to use the built-in local persistent database (.data/gateway-db.json)
# Set to your Supabase / PostgreSQL URI in production or local Postgres:
# e.g. postgresql://postgres:postgres@localhost:5432/ai_gateway
DATABASE_URL=

# External AI Provider Base URLs
GEMINI_WEB2API_BASE_URL=http://localhost:8081/v1
OLLAMA_BASE_URL=http://localhost:11434

# Gateway Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# API Key Generation Prefix
API_KEY_PREFIX=sk_live_


